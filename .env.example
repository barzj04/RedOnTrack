# --- AI analysis (all optional) ---
# Without any of these, the app runs its built-in rule-based analyser (demo mode).

# Recommended for a public deployment: a server-side proxy that holds the key.
# On Vercel this is the bundled /api/analyze function.
# VITE_AI_PROXY_URL=/api/analyze

# Local development only: calls Gemini straight from the browser.
# Never use this on a public site; the key ends up in the JavaScript bundle.
# VITE_GEMINI_API_KEY=your_key_here
# VITE_GEMINI_MODEL=gemini-2.5-flash

# Server-side key for the /api/analyze function (set in your host's dashboard, not here)
# GEMINI_API_KEY=your_key_here
